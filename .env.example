# Local helper scripts only. Copy to .env and load the values into your shell.
# Never commit real account credentials or a Supabase service-role key.
MUQAM_SUPABASE_URL=https://your-project.supabase.co
MUQAM_SUPABASE_ANON_KEY=your-public-anon-key
MUQAM_ADMIN_EMAIL=admin@example.com
MUQAM_ADMIN_PASSWORD=replace-with-a-unique-password
MUQAM_ALLOW_ACCOUNT_CREATION=no
MUQAM_TEST_USER_EMAIL=test-user@example.com
MUQAM_TEST_USER_PASSWORD=replace-with-a-unique-test-password
MUQAM_ALLOW_ACCOUNT_CREATION_TEST=no

    "@capacitor/core": "^8.5.0",
    "@supabase/supabase-js": "^2.112.4",
    "chart.js": "^4.5.0",
    "eslint": "^8.57.1",
    "lucide": "^0.468.0",
    "puppeteer": "^25.9.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  }

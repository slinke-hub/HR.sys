{
  "name": "hr-system",
  "version": "1.0.0",
  "description": "HR Management System",
  "main": "index.js",
  "scripts": {
    "dev": "npm run mobile:web && node scripts/serve-local.mjs",
    "start": "npm run dev",
    "crm:css": "tailwindcss -i ./src/crm-tailwind.css -o ./css/crm-tailwind.css --minify",
    "crm:js": "esbuild ./src/crm-dashboard.jsx --bundle --minify --format=iife --global-name=MogamCrmDashboard --outfile=./js/crm-dashboard.bundle.js",
    "crm:build": "npm run crm:css && npm run crm:js",
    "test:security": "node tests/security-hardening.test.js",
    "test:auth": "node tests/auth-backend-services.test.cjs",
    "test:project-operations-phase-1": "node tests/project-operations-phase-1.test.cjs && node tests/project-operational-dto.test.cjs && node tests/project-operations-phase-1-migration-replay.test.cjs && node tests/runtime-config-isolation.test.cjs",
    "test:backend-readiness": "node tests/backend-shared-logic-readiness.test.cjs && node tests/backend-rls-threat-matrix.test.cjs && node tests/backend-task-readiness.test.cjs && node tests/backend-project-readiness.test.cjs",
    "test:productivity-phase-a": "node tests/productivity-phase-a.test.cjs",
    "test:productivity-phase-b": "node tests/productivity-phase-b.test.cjs",
    "security:check": "npm run test:security && npm audit --audit-level=high",
    "mobile:web": "node scripts/build-mobile.mjs",
    "mobile:web:preview": "node scripts/build-preview.mjs",
    "mobile:web:production": "node scripts/build-production.mjs",
    "mobile:sync": "npm run mobile:web && node --require=./scripts/capacitor-userinfo-shim.cjs ./node_modules/@capacitor/cli/bin/capacitor sync android",
    "mobile:open": "node --require=./scripts/capacitor-userinfo-shim.cjs ./node_modules/@capacitor/cli/bin/capacitor open android",
    "mobile:build:debug": "node scripts/build-android.mjs debug",
    "mobile:build:release": "node scripts/build-android.mjs release"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@capacitor/cli": "^8.5.0",
    "esbuild": "^0.25.9",
    "tailwindcss": "^3.4.17"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/core": "^8.5.1",
    "@supabase/supabase-js": "^2.112.4",
    "@tesseract.js-data/ara": "^1.0.0",
    "@tesseract.js-data/eng": "^1.0.0",
    "chart.js": "^4.5.0",
    "lucide": "^0.468.0",
    "lucide-react": "^0.468.0",
    "pdfjs-dist": "^6.3.289",
    "puppeteer": "^25.9.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tesseract.js": "^7.0.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  }
}

{"kind":"table","sheet":"Instructions","address":"A1:B12","rows":12,"cols":2,"values":[["MUQAM HR — Users Bulk Upload Instructions",null],[null,null],["Step","Instruction"],[1,"Open the Users sheet and delete the yellow example row."],[2,"Do not rename or reorder any column headings."],[3,"Full Name, Nationality, ID/Iqama, Phone, Email, Temporary Password, Department, Job Title, and Role are required."],[4,"Nationality must be Saudi or Non-Saudi."],[5,"Role must be EMPLOYEE, SUPERVISOR, MANAGER, or ADMIN."],[6,"Department and Job Title must match the values configured in MUQAM HR."],[7,"Manager Email is optional, but when supplied it must belong to an existing user."],[8,"Every email must be unique. Passwords must contain at least 8 characters."],[9,"Employee IDs are assigned automatically as MQ-01, MQ-02, and so on."]]}
